# Copy to server/.env (API reads it) and root .env (docker-compose / root scripts).

# ---- required -------------------------------------------------------------
DATABASE_URL=postgresql://voting:voting@localhost:5432/voting?schema=public

# ---- server ----------------------------------------------------------------
PORT=4000
NODE_ENV=development            # development | test | production
WEB_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=12
# Optional: enables the Socket.IO Redis adapter (multi-instance realtime).
# REDIS_URL=redis://localhost:6379
IMPORT_MAX_FILE_MB=5
IMPORT_MAX_ROWS=5000

# ---- live-event capacity (optional) -----------------------------------------
# Prisma pool size. Default is 2 × CPUs + 1; raise for big rooms (stay below
# Postgres max_connections across all API instances).
# DB_POOL_SIZE=30
# Seconds a request may wait for a pooled connection before failing (default 20).
# DB_POOL_TIMEOUT_S=20
# Which proxy hops may set X-Forwarded-For. Default: loopback only (nginx /
# Caddy on the same host). Behind a load balancer use its subnet or a hop count
# (e.g. 1); never "true" when the API is internet-facing.
# TRUST_PROXY=loopback
# libuv threads for password hashing; defaults to the CPU count (min 4).
# UV_THREADPOOL_SIZE=8

# ---- Sign in with Google (optional) -----------------------------------------
# When both are set, attendees sign in with the Google account of their
# registered email and imports create no passwords. See README "Sign-in".
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# Public origin users open (Google redirects to $PUBLIC_URL/api/auth/google/callback).
# Defaults to WEB_ORIGIN.
# PUBLIC_URL=https://vote.example.com
