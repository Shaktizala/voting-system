# Copy to server/.env (API reads it) and root .env (docker-compose / root scripts).

# ---- required -------------------------------------------------------------
DATABASE_URL=postgresql://voting:voting@localhost:5432/voting?schema=public

# ---- server ----------------------------------------------------------------
PORT=4000
NODE_ENV=development            # development | test | production
WEB_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=12
# Optional: enables the Socket.IO Redis adapter (multi-instance realtime).
# REDIS_URL=redis://localhost:6379
IMPORT_MAX_FILE_MB=5
IMPORT_MAX_ROWS=5000
